{
  "name": "azure-cost-iq",
  "version": "4.0.0",
  "description": "Enterprise Azure cost estimation, reservation analysis, and FinOps dashboards — self-hosted, no data leaves your environment",
  "private": true,
  "type": "module",
  "scripts": {
    "dev":        "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build":      "vite build",
    "preview":    "vite preview",
    "start":      "NODE_ENV=production node server/index.js",
    "lint":       "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@azure/arm-advisor":         "^3.0.0",
    "@azure/arm-consumption":     "^9.1.0",
    "@azure/arm-costmanagement":  "1.0.0-beta.2",
    "@azure/arm-managementgroups":"^2.0.0",
    "@azure/arm-reservations":    "^9.0.0",
    "@azure/arm-subscriptions":   "^5.1.0",
    "@azure/identity":            "^4.4.1",
    "chart.js":                   "^4.4.1",
    "compression":                "^1.7.4",
    "concurrently":               "^8.2.2",
    "express":                    "^4.18.2",
    "react":                      "^18.2.0",
    "react-dom":                  "^18.2.0"
  },
  "devDependencies": {
    "@types/react":               "^18.2.66",
    "@types/react-dom":           "^18.2.22",
    "@vitejs/plugin-react":       "^4.2.1",
    "eslint":                     "^8.57.0",
    "eslint-plugin-react":        "^7.34.1",
    "eslint-plugin-react-hooks":  "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "vite":                       "^5.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
