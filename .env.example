# ─────────────────────────────────────────────────────────────────────────────
# AzureCostIQ — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Azure Service Principal (for local dev / non-Azure hosting) ──────────────
# Create an App Registration in Entra ID and generate a client secret.
# Assign roles at Tenant Root Management Group (recommended) or per-scope.
#
# Required RBAC roles:
#   - Cost Management Reader        (microsoft.costmanagement/*)
#   - Reservations Reader           (microsoft.capacity/reservations/read)
#   - Management Group Reader       (microsoft.management/managementgroups/read)
#   - Reader                        (on subscriptions you want to analyze)
#
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-client-secret-value-here

# ── Azure Managed Identity (used automatically on Azure App Service / AKS) ───
# When deployed to Azure App Service with system-assigned managed identity,
# leave AZURE_CLIENT_ID and AZURE_CLIENT_SECRET blank.
# The SDK will automatically use the managed identity.
# AZURE_CLIENT_ID=                  # Leave blank for system-assigned MI

# ── Certificate-based SP (more secure alternative to client secret) ──────────
# AZURE_CLIENT_CERTIFICATE_PATH=/path/to/cert.pem

# ── Default scope (pre-selected in the scope dropdown) ───────────────────────
# Tenant root (recommended for full visibility):
# DEFAULT_SCOPE=/providers/Microsoft.Management/managementGroups/your-tenant-id
#
# Management group:
# DEFAULT_SCOPE=/providers/Microsoft.Management/managementGroups/your-mg-id
#
# Single subscription:
# DEFAULT_SCOPE=/subscriptions/your-subscription-id
DEFAULT_SCOPE=

# ── Server configuration ──────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CAD/USD exchange rate override (default: 1.38) ───────────────────────────
# CAD_RATE=1.38
